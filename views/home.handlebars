<h1>Quản lý Sách</h1>

{{#if error}}<p class="error">{{error}}</p>{{/if}}

<form method="POST" action="/books">
  <input name="code" placeholder="Mã SP (bắt đầu bằng {{prefix}})" required>
  <input name="title" placeholder="Tên sách" required>
  <input name="author" placeholder="Tác giả">
  <input name="price" type="number" min="0" step="any" placeholder="Giá gốc" required>
  <button type="submit">Thêm sách</button>
</form>

<table>
  <tr>
    <th>Mã</th><th>Tên sách</th><th>Tác giả</th>
    <th>Giá gốc</th><th>VAT</th><th>Giá sau thuế</th>
  </tr>
  {{#each books}}
  <tr>
    <td>{{code}}</td>
    <td>{{title}}</td>
    <td>{{author}}</td>
    <td>{{price}}</td>
    <td>{{vat}}%</td>
    <td>{{priceAfterTax}}</td>
  </tr>
  {{else}}
  <tr><td colspan="6">Chưa có sách nào.</td></tr>
  {{/each}}
</table>